# Copy to .env.local. Server-side only; never prefix keys with VITE_.
# The API key from your Gameable account opens the hosted conversation and
# transcription services.
GAMEABLE_API_KEY=
# Optional: point either service somewhere else, with its own key.
# GAMEABLE_CONVERSATION_URL=
# GAMEABLE_CONVERSATION_KEY=
# GAMEABLE_TRANSCRIPTION_URL=
# GAMEABLE_TRANSCRIPTION_KEY=
# Comma-separated exact browser origins. Add your HTTPS LAN origin to test a phone.
HELLO_ORIGINS=https://engine.gameable.com,http://localhost:5180,http://127.0.0.1:5180,http://localhost:4180,http://127.0.0.1:4180,http://localhost:5188,http://127.0.0.1:5188,http://localhost:4188,http://127.0.0.1:4188
HELLO_RELAY_PORT=8788
