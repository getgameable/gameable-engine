{
  "name": "@gameable/example-wasm-hello",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The smallest complete Gameable Engine game: one character, driven from the guest, in both sandbox modes.",
  "license": "MIT",
  "scripts": {
    "import:character": "node scripts/import-character.mjs",
    "dev": "vite",
    "build:guest": "node scripts/build-guest.mjs",
    "build": "npm run build:guest && vite build",
    "build:direct": "vite build --mode direct",
    "preview": "vite preview",
    "test": "vitest run",
    "relay": "node --env-file-if-exists=.env.local scripts/relay.mjs",
    "provision": "node --env-file-if-exists=.env.local scripts/provision.mjs"
  },
  "dependencies": {
    "@getgameable/voxy": "0.1.0",
    "gameable": "*",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.33.0",
    "componentize-qjs": "0.4.4",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
