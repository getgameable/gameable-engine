      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./assets/*": "./assets/*",
    "./wit/*.wit": "./wit/*.wit",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "assets",
    "bin",
    "dist",
    "wit",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepare": "node scripts/sync-files.mjs && tsdown -c tsdown.prepare.config.ts",
    "gen": "node scripts/gen-entries.mjs",
    "gen:check": "node scripts/gen-entries.mjs --check",
    "build": "tsdown && node scripts/build-types.mjs && node scripts/sync-files.mjs --dist",
    "prepack": "node scripts/gen-entries.mjs --check && tsdown && node scripts/build-types.mjs && node scripts/sync-files.mjs --pack && node scripts/publish-manifest.mjs",
    "postpack": "node scripts/publish-manifest.mjs --restore"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@colyseus/sdk": "0.18.4",
    "bitecs": "0.4.0",
    "jolt-physics": "1.1.0",
    "onnxruntime-web": "1.29.0"
  },
  "peerDependencies": {
    "@bytecodealliance/jco": "1.33.0",
