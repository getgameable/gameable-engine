{
  "name": "gameable",
  "version": "0.1.0",
  "type": "module",
  "description": "Gameable Engine: a browser game engine where the world is a gaussian splat, the renderer is WebGPU and all game logic is a WebAssembly component.",
  "keywords": [
    "game-engine",
    "gaussian-splatting",
    "webgpu",
    "webassembly",
    "three",
    "multiplayer"
  ],
  "homepage": "https://engine.gameable.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getgameable/gameable-engine.git",
    "directory": "packages/gameable"
  },
  "bugs": "https://github.com/getgameable/gameable-engine/issues",
  "license": "MIT",
  "bin": {
    "gameable": "./bin/gameable.mjs"
  },
  "exports": {
    ".": {
      "gameable-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk/prelude": {
