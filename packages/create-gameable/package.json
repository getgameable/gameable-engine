{
  "name": "create-gameable",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "npm create gameable — copies a template and wires up a new game.",
  "keywords": [
    "gameable",
    "game-engine",
    "scaffold",
    "create",
    "webgpu",
    "gaussian-splatting"
  ],
  "homepage": "https://engine.gameable.com/start/01-install",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getgameable/gameable-engine.git",
    "directory": "packages/create-gameable"
  },
  "bugs": "https://github.com/getgameable/gameable-engine/issues",
  "license": "MIT",
  "bin": {
    "create-gameable": "./bin/create-gameable.mjs"
  },
  "exports": {
    ".": {
      "gameable-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "sync:templates": "node scripts/sync-templates.mjs",
    "check:templates": "node scripts/sync-templates.mjs --check",
    "prepack": "tsdown && node scripts/sync-templates.mjs",
    "postpack": "node scripts/sync-templates.mjs --clean"
  }
}
